    clique,
    {shackle, {
        git,
        "https://github.com/lpgauth/shackle.git",
        {tag, "0.6.19"}
    }},
    {grpc, {
        git,
        "https://github.com/emqx/grpc-erl.git",
        {tag, "0.7.7"}
    }}
]}.
