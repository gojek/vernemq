%% -*- mode: erlang -*-
%% ex: ft=erlang

%% @doc To register events sidecar webhooks, a list of hook names needs to be configured.
%% Valid hook names: [on_register, on_register_failed, on_publish, on_subscribe, on_unsubscribe, on_deliver, on_offline_message, on_client_wakeup, on_client_offline, on_client_gone, on_delivery_complete, on_session_expired, on_message_drop]
{mapping, "vmq_events_sidecar.hooks", "vmq_events_sidecar.hooks",
 [
  {validators, ["hook_names"]},
  {commented, "[on_register, on_publish]"}
 ]}.

{validator, "hook_names", "hook names must be valid",
 fun(Hooks) ->
    ValidHooks = [on_register,
                  on_register_failed,
                  on_publish,
                  on_subscribe,
                  on_unsubscribe,
                  on_deliver,
                  on_offline_message,
                  on_client_wakeup,
                  on_client_offline,
                  on_client_gone,
                  on_delivery_complete,
                  on_session_expired,
                  on_message_drop],
    HooksList = vmq_schema_util:parse_list(Hooks),
    lists:all(fun(Hook) -> lists:member(Hook, ValidHooks) end, HooksList)
 end}.

{mapping, "vmq_events_sidecar.clique_lead_line", "vmq_events_sidecar.clique_lead_line",
 [{datatype, string},
  hidden,
  {default, "    events                  Manage events sidecar\n"}]}.

%% @doc Configure the maximum number of TCP connections in the sidecar pool.
{mapping, "vmq_events_sidecar.pool_size", "vmq_events_sidecar.pool_size",
 [{datatype, integer},
  hidden,
  {default, 100}]}.

%% @doc Configure the sidecar hostname to be used to connect to.
{mapping, "vmq_events_sidecar.hostname", "vmq_events_sidecar.hostname",
 [{datatype, string},
  {default, "127.0.0.1"}]}.

%% @doc Configure the sidecar port to be used to connect to.
{mapping, "vmq_events_sidecar.port", "vmq_events_sidecar.port",
 [{datatype, integer},
  {default, 8890}]}.

%% @doc Configure the sidecar backlog size to handle backpressure.
{mapping, "vmq_events_sidecar.backlog_size", "vmq_events_sidecar.backlog_size",
 [{datatype, integer},
  hidden,
  {default, 4096}]}.

%% @doc Configure the user type sent as gRPC metadata header.
%% Valid values: merchant, customer, driver, tokopedia-customer, clickstream
{mapping, "vmq_events_sidecar.user_type", "vmq_events_sidecar.user_type",
 [{datatype, string},
  {default, "default"}]}.

%% @doc Configure the gRPC endpoint hostname (bypasses the local sidecar).
%% Leave empty to disable gRPC.
{mapping, "vmq_events_sidecar.grpc_endpoint", "vmq_events_sidecar.grpc_endpoint",
 [{datatype, string},
  hidden,
  {default, ""}]}.

%% @doc Configure the gRPC endpoint port.
{mapping, "vmq_events_sidecar.grpc_port", "vmq_events_sidecar.grpc_port",
 [{datatype, integer},
  hidden,
  {default, 80}]}.

%% @doc Configure the gRPC connection pool size.
{mapping, "vmq_events_sidecar.grpc_pool_size", "vmq_events_sidecar.grpc_pool_size",
 [{datatype, integer},
  hidden,
  {default, 100}]}.

%% @doc Configure the gRPC request timeout in milliseconds.
{mapping, "vmq_events_sidecar.grpc_timeout", "vmq_events_sidecar.grpc_timeout",
 [{datatype, integer},
  hidden,
  {default, 500}]}.

%% @doc Configure the number of gRPC worker processes in the pool.
%% Each worker handles one event at a time for the full gRPC round-trip, so this
%% bounds concurrent in-flight requests. Applied at boot only.
{mapping, "vmq_events_sidecar.grpc_worker_pool_size", "vmq_events_sidecar.grpc_worker_pool_size",
 [{datatype, integer},
  hidden,
  {default, 100}]}.

%% @doc Maximum number of events queued per gRPC worker.
%% Events are dropped when every candidate worker is at this limit (backpressure).
{mapping, "vmq_events_sidecar.grpc_worker_max_queue_len", "vmq_events_sidecar.grpc_worker_max_queue_len",
 [{datatype, integer},
  hidden,
  {default, 2000}]}.

%% @doc Maximum age of a gRPC connection in seconds, after which it is closed and
%% re-established. grpc-erl keeps a connection until it fails, so without this a
%% long-lived node never re-resolves its endpoint. Closing a connection fails
%% whatever was in flight on it, counted as
%% grpc_call_result{result="connection_down"}. 0 disables recycling.
{mapping, "vmq_events_sidecar.grpc_connection_max_age_seconds", "vmq_events_sidecar.grpc_connection_max_age_seconds",
 [{datatype, integer},
  hidden,
  {default, 0}]}.

%% @doc Jitter in seconds applied to grpc_connection_max_age_seconds, so that
%% connections replaced one at a time do not drift into lockstep. Ignored when
%% grpc_connection_max_age_seconds is 0.
{mapping, "vmq_events_sidecar.grpc_connection_age_jitter_seconds", "vmq_events_sidecar.grpc_connection_age_jitter_seconds",
 [{datatype, integer},
  hidden,
  {default, 10}]}.

%% @doc Percentage of events routed to the gRPC endpoint (0-100).
%% 0 = all events go to the local sidecar, 100 = all events go via gRPC.
{mapping, "vmq_events_sidecar.grpc_percentage", "vmq_events_sidecar.grpc_percentage",
 [{datatype, integer},
  hidden,
  {default, 0}]}.

%% @doc Configure the sampling for on_publish events based on ACL names
{mapping, "sample.on_publish.$acl.percentage", "vmq_events_sidecar.sampler.on_publish", 
 [{datatype, integer}]}.

{translation, "vmq_events_sidecar.sampler.on_publish",
  fun(Conf) ->
    vmq_schema_translate:translate_sampling("on_publish", Conf)
  end
}.

%% @doc Configure the sampling for on_deliver events based on ACL names
{mapping, "sample.on_deliver.$acl.percentage", "vmq_events_sidecar.sampler.on_deliver", 
 [{datatype, integer}]}.

{translation, "vmq_events_sidecar.sampler.on_deliver",
  fun(Conf) ->
    vmq_schema_translate:translate_sampling("on_deliver", Conf)
  end
}.

%% @doc Configure the sampling for on_delivery_complete events based on ACL names
{mapping, "sample.on_delivery_complete.$acl.percentage", "vmq_events_sidecar.sampler.on_delivery_complete", 
 [{datatype, integer}]}.

{translation, "vmq_events_sidecar.sampler.on_delivery_complete",
  fun(Conf) ->
    vmq_schema_translate:translate_sampling("on_delivery_complete", Conf)
  end
}.
